    "action/destructive/base": { "light": "coral/900", "dark": "coral/950" },
    "action/disabled": { "light": "neutral/200", "dark": "neutral/800" },
    "accent/blue": { "light": "blue/400", "dark": "blue/400" },
    "accent/coral": { "light": "coral/400", "dark": "coral/400" },
    "accent/yellow": { "light": "yellow/300", "dark": "yellow/300" },
    "accent/green": { "light": "green/400", "dark": "green/400" },
    "accent/blue-subtle": { "light": "blue/100", "dark": "blue/900" },
    "accent/coral-subtle": { "light": "coral/100", "dark": "coral/900" },
    "accent/yellow-subtle": { "light": "yellow/100", "dark": "yellow/900" },
    "accent/green-subtle": { "light": "green/100", "dark": "green/900" },
    "status/info/bg": { "light": "blue/50", "dark": "blue/950" },
    "status/info/border": { "light": "blue/200", "dark": "blue/800" },
    "status/info/text": { "light": "blue/700", "dark": "blue/300" },
    "status/info/solid": { "light": "blue/600", "dark": "blue/500" },
    "status/success/bg": { "light": "green/50", "dark": "green/950" },
    "status/success/border": { "light": "green/200", "dark": "green/800" },
    "status/success/text": { "light": "green/700", "dark": "green/300" },
    "status/success/solid": { "light": "green/600", "dark": "green/500" },
    "status/warning/bg": { "light": "yellow/50", "dark": "yellow/950" },
    "status/warning/border": { "light": "yellow/200", "dark": "yellow/800" },
    "status/warning/text": { "light": "yellow/800", "dark": "yellow/300" },
    "status/warning/solid": { "light": "yellow/400", "dark": "yellow/400" },
    "status/error/bg": { "light": "coral/50", "dark": "coral/950" },
    "status/error/border": { "light": "coral/200", "dark": "coral/800" },
