    "shadow/block": { "light": "neutral/300", "dark": "neutral/950" },
    "overlay/scrim": { "light": "#12110f7a", "dark": "#000000a3" }
  },
  "radius": { "none": 0, "sm": 6, "md": 10, "lg": 16, "xl": 24, "full": 999 },
  "borderWidth": { "default": 1, "strong": 2 },
  "elevation": { "block-sm": 2, "block-md": 4, "block-lg": 6 },
  "font": {
    "family": { "heading": "Bricolage Grotesque", "body": "Geist" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "typeScale": {
    "$note": "Desktop applies from 810px up, Mobile below 810px (matches the Framer breakpoints).",
    "display": { "family": "heading", "weight": "bold", "tracking": -2, "desktop": [64, 72], "mobile": [40, 48] },
    "h1": { "family": "heading", "weight": "bold", "tracking": -2, "desktop": [48, 56], "mobile": [34, 40] },
    "h2": { "family": "heading", "weight": "bold", "tracking": -1.5, "desktop": [40, 48], "mobile": [28, 36] },
    "h3": { "family": "heading", "weight": "bold", "tracking": -1, "desktop": [32, 40], "mobile": [24, 32] },
    "h4": { "family": "heading", "weight": "semibold", "tracking": -0.5, "desktop": [24, 32], "mobile": [20, 28] },
    "h5": { "family": "heading", "weight": "semibold", "tracking": 0, "desktop": [20, 28], "mobile": [18, 26] },
    "h6": { "family": "heading", "weight": "semibold", "tracking": 0, "desktop": [18, 26], "mobile": [16, 24] },
    "body-lg": { "family": "body", "weight": "regular", "tracking": 0, "desktop": [18, 28], "mobile": [17, 26] },
    "body-md": { "family": "body", "weight": "regular", "tracking": 0, "desktop": [16, 24], "mobile": [16, 24] },
    "body-sm": { "family": "body", "weight": "regular", "tracking": 0, "desktop": [14, 20], "mobile": [14, 20] },
    "label-lg": { "family": "body", "weight": "semibold", "tracking": 0, "desktop": [16, 24], "mobile": [16, 24] },
    "label-md": { "family": "body", "weight": "semibold", "tracking": 0, "desktop": [14, 20], "mobile": [14, 20] },
    "label-sm": { "family": "body", "weight": "medium", "tracking": 0.2, "desktop": [12, 16], "mobile": [12, 16] },
    "caption": { "family": "body", "weight": "regular", "tracking": 0.2, "desktop": [12, 16], "mobile": [12, 16] }
  },
  "effects": {
    "block-sm": "0px {elevation.block-sm}px 0px 0px {shadow/block}",
    "block-md": "0px {elevation.block-md}px 0px 0px {shadow/block}",
    "block-lg": "0px {elevation.block-lg}px 0px 0px {shadow/block}",
    "soft-sm": "0px 2px 8px 0px {shadow/soft}",
    "soft-md": "0px 8px 24px -4px {shadow/soft}",
    "soft-lg": "0px 16px 48px -8px {shadow/soft}",
    "focus-ring": "0px 0px 0px 2px {bg/surface}, 0px 0px 0px 4px {border/focus}"
  }
}
