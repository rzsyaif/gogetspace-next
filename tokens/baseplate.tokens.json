{
  "$description": "Baseplate by GoGetSpace — design tokens exported from the Figma library (nUoFs1mdRJZZVOZzAlhgtT). Run `pnpm tokens` after editing to regenerate src/styles/tokens.css.",
  "primitives": {
    "blue": { "50": "#eef3ff", "100": "#dce6ff", "200": "#baccff", "300": "#8eabff", "400": "#5f84ff", "500": "#2f5bff", "600": "#1f45e0", "700": "#1a37b3", "800": "#172e8c", "900": "#142766", "950": "#0c173d" },
    "coral": { "50": "#fff1ee", "100": "#ffe0d9", "200": "#ffc1b3", "300": "#ff9b85", "400": "#ff7558", "500": "#f2553a", "600": "#d63f25", "700": "#b0311c", "800": "#8a2817", "900": "#6b2114", "950": "#3d110a" },
    "yellow": { "50": "#fffaeb", "100": "#fff2c7", "200": "#ffe38a", "300": "#ffd24d", "400": "#ffc21f", "500": "#f5ae00", "600": "#d48a00", "700": "#a86600", "800": "#844f05", "900": "#6c410a", "950": "#3e2302" },
    "green": { "50": "#ecfdf3", "100": "#d1fae2", "200": "#a6f2c8", "300": "#6ee5a8", "400": "#34d183", "500": "#12b76a", "600": "#079455", "700": "#057647", "800": "#085d3a", "900": "#074d31", "950": "#032b1b" },
    "neutral": { "50": "#f8f7f4", "100": "#f1efea", "200": "#e4e1da", "300": "#d1cdc4", "400": "#a8a39a", "500": "#7f7a71", "600": "#605b53", "700": "#48443e", "800": "#302d29", "900": "#1e1c19", "950": "#12110f" },
    "base": { "white": "#ffffff", "black": "#000000" }
  },
  "semantic": {
