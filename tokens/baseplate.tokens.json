    "bg/canvas": { "light": "neutral/50", "dark": "neutral/950" },
    "bg/surface": { "light": "base/white", "dark": "neutral/900" },
    "bg/surface-raised": { "light": "base/white", "dark": "neutral/800" },
    "bg/subtle": { "light": "neutral/100", "dark": "neutral/800" },
    "bg/muted": { "light": "neutral/200", "dark": "neutral/700" },
    "bg/inverse": { "light": "neutral/900", "dark": "neutral/50" },
    "text/primary": { "light": "neutral/900", "dark": "neutral/50" },
    "text/secondary": { "light": "neutral/600", "dark": "neutral/300" },
    "text/tertiary": { "light": "neutral/500", "dark": "neutral/400" },
    "text/disabled": { "light": "neutral/400", "dark": "neutral/600" },
    "text/inverse": { "light": "base/white", "dark": "neutral/900" },
    "text/on-action": { "light": "base/white", "dark": "base/white" },
    "text/link": { "light": "blue/600", "dark": "blue/300" },
    "text/brand": { "light": "blue/500", "dark": "blue/300" },
    "border/default": { "light": "neutral/200", "dark": "neutral/700" },
    "border/strong": { "light": "neutral/300", "dark": "neutral/600" },
    "border/secondary": { "light": "neutral/600", "dark": "neutral/300" },
    "border/focus": { "light": "blue/500@16", "dark": "blue/400@16" },
    "action/primary/default": { "light": "blue/500", "dark": "blue/500" },
    "action/primary/hover": { "light": "blue/600", "dark": "blue/600" },
    "action/primary/pressed": { "light": "blue/700", "dark": "blue/700" },
    "action/primary/base": { "light": "blue/800", "dark": "blue/950" },
    "action/secondary/default": { "light": "base/white", "dark": "neutral/800" },
    "action/secondary/hover": { "light": "neutral/100", "dark": "neutral/700" },
    "action/secondary/pressed": { "light": "neutral/200", "dark": "neutral/600" },
    "action/secondary/base": { "light": "neutral/300", "dark": "neutral/950" },
    "action/ghost/hover": { "light": "blue/50", "dark": "blue/900" },
